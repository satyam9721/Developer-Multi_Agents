# Core Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Workspace Root Directory (Defaults to ./workspace under backend)
WORKSPACE_ROOT=./workspace

# Database Configuration (PostgreSQL - Optional for local boot)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_agent_db

# Redis Configuration (Optional for local boot)
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (Optional for local boot; mock used if unset)
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=

# GitHub API Configuration (Optional)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Celery Task Queue Configuration (Optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
